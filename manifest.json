{
  "manifest_version": 3,
  "name": "RVCE Auto-Login",
  "version": "4.0",
  "description": "Automates credential entry and keeps session alive for RV Institutions Gateway.",
  "permissions": ["storage"],
  "icons": { "128": "icon128.png" },
  "action": { "default_popup": "popup.html" },
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": ["https://rvce-fw.rvce.edu.in:8090/*", "http://rvce-fw.rvce.edu.in:8090/*"],
      "js": ["submit.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://rvce-fw.rvce.edu.in:8090/*",
        "http://rvce-fw.rvce.edu.in:8090/*",
        "http://172.16.0.2:1003/*",
        "https://172.16.0.2:1003/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
